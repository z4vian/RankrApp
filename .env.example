# Rankr — environment variable template
#
# Copy this file to `.env` at the project root and fill in real values:
#   cp .env.example .env
#
# All EXPO_PUBLIC_* vars are inlined into the client bundle by Metro at build
# time. They are not secret — anyone who downloads the app can extract them.
# Use a backend proxy for anything that must remain confidential.

# TMDB (https://www.themoviedb.org/) — used for movie search & recommendations
EXPO_PUBLIC_TMDB_API_KEY=

# RAWG (https://rawg.io/apidocs) — used for game search & recommendations
EXPO_PUBLIC_RAWG_API_KEY=
